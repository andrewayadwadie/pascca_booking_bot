{
  // must match the Worker's name in Cloudflare
  "name": "pascca-booking-bot",
  // the worker file in the repo (change it if you renamed the file)
  "main": "telegram-booking-worker.js",
  "compatibility_date": "2025-11-01",
  // keep BOT_TOKEN / CHAT_ID set in the dashboard when GitHub deploys again
  "keep_vars": true,
  "workers_dev": true
}
