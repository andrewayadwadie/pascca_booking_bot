{
  // must match the Worker's name in Cloudflare
  "name": "pascca-booking-bot",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  // the website: every file in public/ is served as is; anything else reaches src/worker.js
  "assets": { "directory": "./public" },
  // keep BOT_TOKEN and CHAT_ID that are set in the Cloudflare dashboard when GitHub deploys
  "keep_vars": true,
  "workers_dev": true,
  "observability": { "enabled": true },
  // run the booking code next to Telegram's servers, so sending a booking never depends on the visitor's nearest Cloudflare location
  "placement": { "mode": "targeted", "hostname": "api.telegram.org" }
}
